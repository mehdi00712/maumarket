rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ==========================================================
       AUTHENTICATION AND ROLE HELPERS
    ========================================================== */

    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasUserDoc() {
      return signedIn() && exists(userPath());
    }

    function userDoc() {
      return get(userPath());
    }

    function notBlocked() {
      return hasUserDoc()
        && userDoc().data.blocked != true;
    }

    function isAdmin() {
      return notBlocked()
        && userDoc().data.role == "admin";
    }

    function isApprovedSeller() {
      return notBlocked()
        && userDoc().data.role == "seller"
        && userDoc().data.approved == true;
    }

    function isDelivery() {
      return notBlocked()
        && userDoc().data.role == "delivery"
        && userDoc().data.approved == true;
    }

    function isCustomer() {
      return notBlocked()
        && userDoc().data.role == "customer";
    }

    function changedOnly(keys) {
      return request.resource.data
        .diff(resource.data)
        .changedKeys()
        .hasOnly(keys);
    }

    function changedNone(keys) {
      return request.resource.data
        .diff(resource.data)
        .changedKeys()
        .hasNone(keys);
    }

    function ownsExistingDocument(fieldName) {
      return signedIn()
        && resource.data[fieldName] == request.auth.uid;
    }

    function keepsOwner(fieldName) {
      return request.resource.data[fieldName] == resource.data[fieldName];
    }

    function hasSellerIds(data) {
      return data.keys().hasAny(["sellerIds"])
        && data.sellerIds is list;
    }

    function orderBelongsToSeller(data) {
      return isApprovedSeller()
        && (
          (
            hasSellerIds(data)
            && data.sellerIds.hasAny([request.auth.uid])
          )
          || data.sellerId == request.auth.uid
          || data.merchantId == request.auth.uid
          || data.shopId == request.auth.uid
        );
    }

    function orderBelongsToCustomer(data) {
      return signedIn()
        && data.customerId == request.auth.uid;
    }

    function deliveryJobBelongsToDriver(data) {
      return isDelivery()
        && data.driverId == request.auth.uid;
    }

    function orderBelongsToDriver(data) {
      return isDelivery()
        && (
          data.driverId == request.auth.uid
          || data.deliveryGuyId == request.auth.uid
        );
    }

    /*
      Product options are stored inside product, cart and order documents.

      Supported option fields include:
      name, value, unit, displayValue, sellerPrice, buyerPrice, stock,
      sku, productCode, image, measurementValue, measurementUnit,
      sizeValue and sizeUnit.

      These fields do not need separate collection rules because they are
      protected by the parent product/cart/order document permissions.
    */

    /* ==========================================================
       ADMIN-CONTROLLED FIELD HELPERS
    ========================================================== */

    function featuredAdminFields() {
      return [
        "featuredShop",
        "featuredStatus",
        "featuredExpiry",
        "featuredSince",
        "featuredPaymentVerified",
        "showInExploreShops",
        "featuredRequestId",
        "featuredApprovedAt",
        "featuredApprovedBy",
        "featuredRejectedAt",
        "featuredRejectedBy",
        "featuredRejectReason"
      ];
    }

    function productAdminFields() {
      return [
        "approved",
        "approvalStatus",
        "approvedAt",
        "approvedBy",
        "rejectedAt",
        "rejectedBy",
        "rejectReason",
        "moderationStatus",
        "moderatedAt",
        "moderatedBy",
        "featured",
        "featuredAt",
        "featuredBy",
        "platformCommission",
        "platformFee",
        "sellerId",
        "ownerId",
        "createdAt"
      ];
    }

    function sellerDidNotCreateFeaturedAccess() {
      return !request.resource.data.keys().hasAny(featuredAdminFields());
    }

    /* ==========================================================
       USERS
    ========================================================== */

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role in ["customer", "seller"]
        && request.resource.data.blocked != true
        && (
          !request.resource.data.keys().hasAny(["approved"])
          || request.resource.data.approved == false
        );

      allow read: if signedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      /*
        Users may update ordinary profile information only.
        Roles, approval, blocking and administrator fields stay protected.
      */
      allow update: if signedIn()
        && request.auth.uid == userId
        && changedOnly([
          "name",
          "fullName",
          "phone",
          "photoURL",
          "profileImage",
          "address",
          "location",
          "deliveryAddress",
          "deliveryLatitude",
          "deliveryLongitude",
          "updatedAt",
          "lastLoginAt",
          "fcmToken",
          "fcmTokens"
        ]);

      allow update, delete: if isAdmin();
    }

    /* ==========================================================
       SHOPS
    ========================================================== */

    match /shops/{shopId} {
      allow read: if true;

      allow create: if isApprovedSeller()
        && request.resource.data.ownerId == request.auth.uid
        && sellerDidNotCreateFeaturedAccess();

      allow update: if isAdmin()
        || (
          isApprovedSeller()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && changedNone(featuredAdminFields())
        )
        || (
          signedIn()
          && changedOnly([
            "totalReviews",
            "ratingSum",
            "averageRating"
          ])
        );

      allow delete: if isAdmin();
    }

    /* ==========================================================
       FEATURED SHOP REQUESTS
    ========================================================== */

    match /featuredShopRequests/{requestId} {
      allow create: if isApprovedSeller()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == "pending"
        && !request.resource.data.keys().hasAny([
          "approvedAt",
          "approvedBy",
          "rejectedAt",
          "rejectedBy",
          "rejectReason",
          "featuredExpiry",
          "paymentVerifiedAt",
          "paymentVerifiedBy"
        ]);

      allow read: if isAdmin()
        || (
          isApprovedSeller()
          && resource.data.sellerId == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }

    /* ==========================================================
       FEATURED SHOP PAYMENT RECORDS

       Supported structures:
       1. featured-shop-payments/{paymentId}
       2. featured-shop-payments/{sellerId}/payments/{paymentId}
    ========================================================== */

    match /featured-shop-payments/{paymentId} {
      allow create: if isApprovedSeller()
        && request.resource.data.sellerId == request.auth.uid
        && request.resource.data.status == "pending"
        && !request.resource.data.keys().hasAny([
          "verified",
          "verifiedAt",
          "verifiedBy",
          "rejectedAt",
          "rejectedBy",
          "rejectReason"
        ]);

      allow read: if isAdmin()
        || (
          isApprovedSeller()
          && resource.data.sellerId == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }

    match /featured-shop-payments/{sellerId} {
      allow read: if isAdmin()
        || (
          isApprovedSeller()
          && request.auth.uid == sellerId
        );

      allow create: if isApprovedSeller()
        && request.auth.uid == sellerId;

      allow update, delete: if isAdmin();

      match /payments/{paymentId} {
        allow create: if isApprovedSeller()
          && request.auth.uid == sellerId
          && (
            !request.resource.data.keys().hasAny(["sellerId"])
            || request.resource.data.sellerId == request.auth.uid
          )
          && (
            !request.resource.data.keys().hasAny(["status"])
            || request.resource.data.status == "pending"
          )
          && !request.resource.data.keys().hasAny([
            "verified",
            "verifiedAt",
            "verifiedBy",
            "rejectedAt",
            "rejectedBy",
            "rejectReason"
          ]);

        allow read: if isAdmin()
          || (
            isApprovedSeller()
            && request.auth.uid == sellerId
          );

        allow update, delete: if isAdmin();
      }

      match /{document=**} {
        allow create: if isApprovedSeller()
          && request.auth.uid == sellerId;

        allow read: if isAdmin()
          || (
            isApprovedSeller()
            && request.auth.uid == sellerId
          );

        allow update, delete: if isAdmin();
      }
    }

    /* ==========================================================
       PRODUCTS AND PRODUCT OPTIONS
    ========================================================== */

    match /products/{productId} {
      allow read: if true;

      /*
        Product creation is handled by createProductSecurely().
        Direct browser creation remains blocked.
      */
      allow create: if false;

      allow update: if isAdmin()
        || (
          isApprovedSeller()
          && resource.data.sellerId == request.auth.uid
          && request.resource.data.sellerId == resource.data.sellerId
          && changedNone(productAdminFields())
        )
        || (
          signedIn()
          && changedOnly([
            "totalReviews",
            "ratingSum",
            "averageRating"
          ])
        );

      allow delete: if isAdmin()
        || (
          isApprovedSeller()
          && resource.data.sellerId == request.auth.uid
        );
    }

    /* ==========================================================
       BANNERS
    ========================================================== */

    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    /* ==========================================================
       WISHLISTS
    ========================================================== */

    match /wishlists/{userId} {
      allow read, write: if signedIn()
        && request.auth.uid == userId;

      match /items/{itemId} {
        allow read, write: if signedIn()
          && request.auth.uid == userId;
      }
    }

    /* ==========================================================
       SAVED CUSTOMER ADDRESSES
    ========================================================== */

    match /addresses/{userId} {
      allow read, write: if signedIn()
        && request.auth.uid == userId;

      match /items/{addressId} {
        allow read, write: if signedIn()
          && request.auth.uid == userId;
      }
    }

    /* ==========================================================
       DELIVERY JOBS
    ========================================================== */

    match /deliveryJobs/{jobId} {
      /*
        Administrators may read every job.
        Drivers may read only jobs assigned to their own account.
        Driver queries must include:
        where("driverId", "==", currentUser.uid)
      */
      allow read: if isAdmin()
        || deliveryJobBelongsToDriver(resource.data);

      allow create, delete: if isAdmin();

      allow update: if isAdmin();

      allow update: if deliveryJobBelongsToDriver(resource.data)
        && request.resource.data.driverId == resource.data.driverId
        && changedOnly([
          "orderStatus",
          "deliveryStatus",
          "pickedUpAt",
          "outForDeliveryAt",
          "deliverySubmittedAt",
          "deliverySignature",
          "deliverySignedBy",
          "deliveryNote",
          "deliveryProofUrl",
          "deliveryProofUrls",
          "deliveryPhotoUrl",
          "deliveryGuyId",
          "deliveryGuyName",
          "driverId",
          "driverName",
          "active",
          "adminDeliveryValidated",
          "adminDeliveryRejectReason",
          "updatedAt"
        ]);
    }

    /* ==========================================================
       ORDERS
    ========================================================== */

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.customerId is string
        && request.resource.data.items is list;

      allow read: if isAdmin()
        || orderBelongsToDriver(resource.data)
        || orderBelongsToSeller(resource.data)
        || orderBelongsToCustomer(resource.data);

      allow update: if isAdmin();

      /*
        Customers may submit or replace payment proof information only.
      */
      allow update: if orderBelongsToCustomer(resource.data)
        && request.resource.data.customerId == resource.data.customerId
        && changedOnly([
          "paymentStatus",
          "paymentProofUrl",
          "paymentProofUrls",
          "paymentSubmittedAt",
          "updatedAt"
        ]);

      /*
        A seller may update readiness/status fields only on an order that
        contains their seller ID. Product-option details remain immutable
        after checkout.
      */
      allow update: if orderBelongsToSeller(resource.data)
        && request.resource.data.customerId == resource.data.customerId
        && request.resource.data.sellerIds == resource.data.sellerIds
        && changedOnly([
          "orderStatus",
          "sellerReadyAt",
          "sellerStatuses",
          "sellerStatusUpdatedAt",
          "pickupStops",
          "sellerBreakdown",
          "updatedAt"
        ]);

      /*
        A driver may update delivery workflow fields only on an order
        assigned to that driver.
      */
      allow update: if orderBelongsToDriver(resource.data)
        && request.resource.data.driverId == resource.data.driverId
        && changedOnly([
          "orderStatus",
          "deliveryStatus",
          "pickedUpAt",
          "outForDelivery",
          "outForDeliveryAt",
          "deliverySubmittedAt",
          "deliverySignature",
          "deliverySignedBy",
          "deliveryNote",
          "deliveryProofUrl",
          "deliveryProofUrls",
          "deliveryPhotoUrl",
          "deliveryGuyId",
          "deliveryGuyName",
          "driverId",
          "driverName",
          "active",
          "adminDeliveryValidated",
          "adminDeliveryRejectReason",
          "updatedAt"
        ]);

      allow delete: if isAdmin();
    }

    /* ==========================================================
       PRODUCT SLOT / QUOTA REQUESTS
    ========================================================== */

    match /quotaRequests/{requestId} {
      allow create: if isApprovedSeller()
        && request.resource.data.sellerId == request.auth.uid;

      allow read: if isAdmin()
        || (
          isApprovedSeller()
          && resource.data.sellerId == request.auth.uid
        );

      allow update, delete: if isAdmin();
    }

    /* ==========================================================
       CARTS

       Cart items may contain the complete selected option snapshot:
       selectedOptionName, selectedOptionValue, selectedOptionUnit,
       selectedOptionDisplayValue, sellerPrice, buyerPrice, SKU,
       productCode and option image.
    ========================================================== */

    match /carts/{userId} {
      allow read, write: if signedIn()
        && request.auth.uid == userId;

      match /items/{itemId} {
        allow read, write: if signedIn()
          && request.auth.uid == userId;
      }
    }

    /* ==========================================================
       REVIEWS
    ========================================================== */

    match /reviews/{reviewId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid;

      allow update: if signedIn()
        && resource.data.customerId == request.auth.uid
        && request.resource.data.customerId == resource.data.customerId;

      allow delete: if isAdmin()
        || (
          signedIn()
          && resource.data.customerId == request.auth.uid
        );
    }

    /* ==========================================================
       PAYOUTS
    ========================================================== */

    match /payouts/{payoutId} {
      allow read: if isAdmin()
        || (
          isApprovedSeller()
          && resource.data.sellerId == request.auth.uid
        );

      allow create, update, delete: if isAdmin();
    }

    /* ==========================================================
       NOTIFICATIONS
    ========================================================== */

    match /notifications/{notificationId} {
      allow read: if isAdmin()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
        )
        || (
          signedIn()
          && resource.data.recipientId == request.auth.uid
        );

      /*
        Notification creation should normally be performed by trusted
        Cloud Functions or administrators.
      */
      allow create: if isAdmin();

      allow update: if signedIn()
        && (
          resource.data.userId == request.auth.uid
          || resource.data.recipientId == request.auth.uid
        )
        && changedOnly([
          "read",
          "readAt",
          "updatedAt"
        ]);

      allow delete: if isAdmin()
        || (
          signedIn()
          && (
            resource.data.userId == request.auth.uid
            || resource.data.recipientId == request.auth.uid
          )
        );
    }

    /* ==========================================================
       CATEGORIES
    ========================================================== */

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    /* ==========================================================
       ADMIN AUDIT LOGS
    ========================================================== */

    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();

      /*
        Client-side writes are blocked. Use trusted server code or
        Cloud Functions for audit-log creation.
      */
      allow create, update, delete: if false;
    }

    /* ==========================================================
       DEFAULT DENY
    ========================================================== */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
